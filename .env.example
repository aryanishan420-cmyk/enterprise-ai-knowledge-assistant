# Copy to .env and edit. NEVER commit .env or real keys.
# Every variable below is read by the application (see backend/config.py, frontend/common.py).

# --- LLM (required only for /chat; search works without it) ---
OPENAI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# --- Embeddings ---
# "sentence-transformers" = semantic (downloads the model from Hugging Face on first use)
# "hashing"               = offline, lexical only (tests / no-network use; NOT semantic)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Storage ---
VECTOR_STORE_PATH=./data/vector_store
DATABASE_URL=sqlite:///./data/app.db

# --- Retrieval / chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
SIMILARITY_THRESHOLD=0.0

# --- Limits / security ---
MAX_UPLOAD_MB=10
# If set, upload/delete/metrics require the header "X-API-Token: <value>".
ADMIN_TOKEN=

# --- Logging ---
LOG_LEVEL=INFO

# --- Frontend only (Streamlit) ---
API_BASE_URL=http://127.0.0.1:8000
